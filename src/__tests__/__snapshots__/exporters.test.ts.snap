{
  "content": "from django.db import models

class Users(models.Model):
    id = models.BigIntegerField(primary_key=True)
    email = models.CharField(max_length=255, unique=True)
    nickname = models.CharField(max_length=50, null=True, blank=True, default='guest')
    balance = models.CharField(default=0)
    created_at = models.DateTimeField()
    active = models.BooleanField(default=true)

    class Meta:
        db_table = 'users'
        indexes = [
            models.Index(fields=['nickname'], name='idx_users_nickname'),
        ]

class Posts(models.Model):
    id = models.IntegerField(primary_key=True)
    user_id = models.BigIntegerField()
    body = models.TextField(null=True, blank=True)
    user = models.ForeignKey('Users', on_delete=models.CASCADE)

    class Meta:
        db_table = 'posts'
        indexes = [
            models.Index(fields=['user_id', 'id'], name='uq_posts_user'),
        ]
",
  "filename": "models.py",
  "language": "python",
}
`;

