{
  "content": "CREATE TABLE "users" (
  "id" BIGSERIAL NOT NULL,
  "email" VARCHAR(255) NOT NULL UNIQUE,
  "nickname" VARCHAR(50) DEFAULT 'guest',
  "balance" DECIMAL(10, 2) NOT NULL DEFAULT 0,
  "created_at" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  "active" BOOLEAN NOT NULL DEFAULT TRUE,
  PRIMARY KEY ("id")
);

CREATE INDEX "idx_users_nickname" ON "users" ("nickname");

CREATE TABLE "posts" (
  "id" SERIAL NOT NULL,
  "user_id" BIGINT NOT NULL,
  "body" TEXT,
  PRIMARY KEY ("id")
);

CREATE UNIQUE INDEX "uq_posts_user" ON "posts" ("user_id", "id");

ALTER TABLE "posts" ADD CONSTRAINT "fk_posts_user" FOREIGN KEY ("user_id") REFERENCES "users" ("id") ON DELETE CASCADE ON UPDATE NO ACTION;
",
  "filename": "schema.sql",
  "language": "sql",
}
`;

exports[`builtin exporters > sqlite > django 1`] = `
{
  "content": "from django.db import models

class Users(models.Model):
    id = models.BigIntegerField(primary_key=True)
    email = models.CharField(max_length=255, unique=True)
    nickname = models.CharField(max_length=50, null=True, blank=True, default='guest')
    balance = models.CharField(default=0)
    created_at = models.DateTimeField()
    active = models.BooleanField(default=true)

    class Meta:
        db_table = 'users'
        indexes = [
            models.Index(fields=['nickname'], name='idx_users_nickname'),
        ]

class Posts(models.Model):
    id = models.IntegerField(primary_key=True)
    user_id = models.BigIntegerField()
    body = models.TextField(null=True, blank=True)
    user = models.ForeignKey('Users', on_delete=models.CASCADE)

    class Meta:
        db_table = 'posts'
        indexes = [
            models.Index(fields=['user_id', 'id'], name='uq_posts_user'),
        ]
",
  "filename": "models.py",
  "language": "python",
}
`;

